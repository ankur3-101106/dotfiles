{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "inverted": false
        },
        "clock": {
            "background": true,
            "showDate": true,
            "showIcon": false
        },
        "dragThreshold": 5,
        "persistent": false,
        "showOnHover": true,
        "statusIcons": [
            {
                "enabled": false,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": false,
                "id": "microphone"
            },
            {
                "enabled": true,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "activeTrail": false,
            "occupiedBg": false,
            "showWindows": true,
            "shown": 6
        }
    },
    "dashboard": {
        "showOnHover": true,
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "playback": [
                "/usr/bin/vlc",
                "--started-from-file"
            ],
            "terminal": [
                "kitty"
            ]
        }
    },
    "launcher": {
        "enableDangerousActions": false,
        "hiddenApps": [
            "xfce4-about"
        ],
        "maxShown": 11,
        "showOnHover": true,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": true,
            "variants": true,
            "wallpapers": true
        }
    },
    "services": {
        "maxVolume": 2,
        "useTwelveHourClock": true
    },
    "sidebar": {
        "dragThreshold": 25,
        "enabled": true
    },
    "utilities": {
        "cards": {
            "quickToggles": true,
            "recorder": false
        },
        "quickToggles": [
            {
                "enabled": true,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "mic"
            },
            {
                "enabled": true,
                "id": "settings"
            },
            {
                "enabled": true,
                "id": "gameMode"
            },
            {
                "enabled": true,
                "id": "dnd"
            },
            {
                "enabled": true,
                "id": "vpn"
            }
        ]
    }
